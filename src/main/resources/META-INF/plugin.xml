<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.yonyoucloud.git-rebase-push-assistant</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Git Rebase and Push Assistant</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://www.yonyoucloud.com">yonyou</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
    Automates Git rebase and push workflows with one-click operations. Features include:
    • Auto-rebase current branch onto target branch
    • Smart commit and force-push with lease
    • Auto-create merge requests (GitLab/GitHub)
    • AI-powered commit message generation (OpenAI integration)
    • Arthas hotfix script generator for Java hot-patching
    • Webhook integration support
    • JIRA ticket integration

    一键自动化 Git 变基和推送工作流。功能包括：
    • 自动变基当前分支到目标分支
    • 智能提交和安全强制推送
    • 自动创建合并请求（GitLab/GitHub）
    • AI 智能生成提交信息（OpenAI 集成）
    • Arthas 热修复脚本生成器，用于 Java 热补丁
    • Webhook 集成支持
    • JIRA 工单集成
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="MyToolWindow" factoryClass="com.examplecn.GitPluginWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowPalette"/>
        <notificationGroup id="Git Rebase Plugin" displayType="BALLOON"/>
        <projectConfigurable parentId="tools" instance="com.examplecn.config.GitRebaseSettingsConfigurable"
                             id="com.examplecn.config.GitRebaseSettingsConfigurable"
                             displayName="Git Rebase &amp; Push"/>
    </extensions>

    <!-- Actions -->
    <actions>
        <action id="GitRebaseAndPush"
                class="com.examplecn.action.GitRebaseAndPushAction"
                icon="AllIcons.Vcs.Push">
            <add-to-group group-id="Vcs.CommitExecutor.Actions" anchor="last"/>
        </action>
        <action id="ArthasHotfix"
                class="com.examplecn.action.ArthasHotfixAction"
                icon="AllIcons.Actions.Execute"
                text="Generate Arthas Hotfix Script"
                description="Generate Arthas hotfix script from compiled .class files">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>

</idea-plugin>
